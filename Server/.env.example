# Server environment variables
# Copy this file to .env and adjust values for local development

# Port the server listens on
PORT=8082

# Hostname for display/logging (not used for binding)
HOST=localhost

# MongoDB connection string (replace with your own)
# Format: mongodb+srv://<user>:<password>@cluster0.xyz.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DBNAME=g1card

# Mistral AI integration (role-specific keys)
# Keep these in Server/.env only. Never commit real keys.
MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions
MISTRAL_MODEL=mistral-large-latest
MISTRAL_API_KEY_PATIENT=
MISTRAL_API_KEY_HOSPITAL=
MISTRAL_API_KEY_ADMIN=
