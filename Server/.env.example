# Server environment variables
# Copy this file to .env and adjust values for local development

# Port the server listens on
PORT=8082

# Hostname for display/logging (not used for binding)
HOST=localhost

# MongoDB connection string (replace with your own)
# Format: mongodb+srv://<user>:<password>@cluster0.xyz.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DBNAME=g1card

# Mistral AI integration (role-specific keys)
# Keep these in Server/.env only. Never commit real keys.
MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions
MISTRAL_MODEL=mistral-small-latest
MISTRAL_API_KEY_PATIENT=
MISTRAL_API_KEY_HOSPITAL=
MISTRAL_API_KEY_ADMIN=

# Frontend URL used for links in emails (Login to G1card, etc.)
# Defaults to https://g1card.vercel.app — set to http://localhost:5173 only for local testing
APP_BASE_URL=https://g1card.vercel.app

# ---------- AI providers (all optional; set any you have, more = more resilient) ----------
# Calls go to the first available provider/model; failures (rate limit, quota, bad key,
# timeout) put that model on a cooldown and the next one is tried immediately.
# Free keys: Groq https://console.groq.com/keys · Gemini https://aistudio.google.com/apikey
#            OpenRouter https://openrouter.ai/keys · Cerebras https://cloud.cerebras.ai
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
# Order to try providers, and routing: "priority" (best first) or "spread" (rotate to share quotas)
AI_PROVIDER_ORDER=groq,gemini,mistral,openrouter,cerebras
AI_ROUTING=priority
# Optional per-provider model overrides (comma separated), e.g.
# GROQ_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile
# OPENROUTER_MODELS=google/gemma-4-31b-it:free
# AI_TIMEOUT_MS=30000
